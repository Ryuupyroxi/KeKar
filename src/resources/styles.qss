/* KeKar stylesheet.
 *
 * Warm neutrals, generous spacing, clear focus rings. The end user is a
 * non-technical landlord, so nothing here is clever.
 *
 * Fonts are set in code (src/ui/theme.py) rather than here. An earlier version
 * of this file had `QWidget { font-size: 14px; }`, which overrode the
 * application font on every widget and made the form fields render too small
 * to read. Do not reintroduce a global font-size rule.
 *
 * Loaded by src/app.py when the bundle ships this file. A missing file is not
 * an error — the app falls back to the Qt default theme and still works.
 */

QMainWindow, QDialog {
    background: #f5f4f1;
}

QGroupBox {
    font-weight: 600;
    border: 1px solid #ddd8d0;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    color: #4a453e;
}

QPushButton {
    padding: 7px 16px;
    border: 1px solid #c9c4bc;
    border-radius: 6px;
    background: #ffffff;
    min-height: 20px;
}

QPushButton:hover {
    background: #efece6;
}

QPushButton:pressed {
    background: #e4dfd6;
}

QPushButton:default {
    background: #2e5e4e;
    border-color: #2e5e4e;
    color: #ffffff;
}

QPushButton:default:hover {
    background: #265042;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QTextEdit, QPlainTextEdit {
    padding: 6px;
    border: 1px solid #c9c4bc;
    border-radius: 5px;
    background: #ffffff;
    selection-background-color: #2e5e4e;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QComboBox:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #2e5e4e;
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 18px;
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 18px;
}

QListWidget {
    border: 1px solid #ddd8d0;
    border-radius: 6px;
    background: #ffffff;
}

QListWidget::item {
    border-bottom: 1px solid #f0ede8;
}

QListWidget::item:selected {
    background: #e3efe9;
}

QTableWidget {
    border: 1px solid #ddd8d0;
    border-radius: 6px;
    gridline-color: #efece6;
}

QHeaderView::section {
    background: #efece6;
    color: #4a453e;
    padding: 6px;
    border: none;
    border-bottom: 1px solid #ddd8d0;
    font-weight: 600;
}

QScrollArea {
    border: none;
}

QScrollBar:vertical {
    width: 12px;
    background: transparent;
}

QScrollBar::handle:vertical {
    background: #c9c4bc;
    border-radius: 6px;
    min-height: 30px;
}

QToolTip {
    background: #2b2b28;
    color: #ffffff;
    padding: 6px;
    border: none;
}
